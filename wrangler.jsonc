{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ia-for-pm",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/index.js"
}
